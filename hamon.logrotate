# logrotate config for the hamon winston logs - install as /etc/logrotate.d/hamon
#
# copytruncate, not create/postrotate: every worker thread opens its own winston
# File transport on these files (dozens of fds), all with O_APPEND, so after an
# in-place truncate each writer carries on at the new end of file - no hamon
# restart or signal needed.  Lines written during the copy are lost, which at
# daily rotation is a second or so of info logging.
#
# su: src/ is group-writable, which logrotate refuses to rotate in as root.

/home/greg/hamon/src/combined.log /home/greg/hamon/src/error.log {
    su greg greg
    daily
    rotate 30
    dateext
    compress
    copytruncate
    missingok
    notifempty
}

# hamon's stdout (systemd StandardOutput=append: in ha-mon.service).  Monthly,
# with last month left uncompressed, so recent output is at hand when checking
# the effect of a change.  Needs the append: unit (O_APPEND) to be in effect -
# under the old file: setting a truncate leaves the writer at its old offset.
/home/greg/hamon/hamon.log {
    su greg greg
    monthly
    rotate 3
    dateext
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
}
