# 
# hamon server systemd service configuration file
# install to /usr/lib/systemd/system/ha-mon.service
# then systemctl daemon-reload
# & then systemctl enable hamon.service
# & then systemctl start hamon.service

[Unit]
Description=HA KNX Monitoring Service
# at boot: the database, docker and the VPN containers first, so container
# sites don't start into a back-off (hamon-vpn.service waits for the tunnels)
Wants=network-online.target hamon-vpn.service
After=multi-user.target network-online.target docker.service influxdb.service hamon-vpn.service

[Service]
Environment=HOME=/home/greg
Type=idle

# working directory is /home/greg/hamon
ExecStart=/opt/node24/bin/node /home/greg/hamon/src/hamon.js
StandardOutput=append:/home/greg/hamon/hamon.log
StandardError=append:/home/greg/hamon/hamon.err

[Install]
WantedBy=multi-user.target
