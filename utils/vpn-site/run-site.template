#!/bin/bash
#
# @SITE@.sh - run the OpenVPN client container for site @SITE@
#
# Generated by utils/vpn-site/add-site.sh on @DATE@ from utils/vpn-site/run-site.template.
# Change the values below, or re-run add-site.sh with -f (it keeps the
# address and port).
#
# The container dials the site's OpenVPN server (@KIND@) and forwards UDP
# @PORT@ on @IPADDR@ to the KNX interface @DEST@:@DESTPORT@ on the site LAN;
# hamon.yml has dns: @IPADDR@, port: @PORT@.
#
# usage: @SITE@.sh           start it (fails if a container called @SITE@ exists)
#        @SITE@.sh restart   remove the running one first, then start
#

set -o nounset

LOCATION=@SITE@
LOC_IPADDR=@IPADDR@
LOC_PORT=@PORT@
CONT_PORT=@PORT@
VPN_REMOTEDEST=@DEST@
VPN_REMOTEPORT=@DESTPORT@
IMAGE=@IMAGE@
# an absolute path, not ~: under sudo ~ is /root, and the container would
# mount an empty directory, never connect, and still report healthy
SITEDIR=@VPNDIR@/@SITE@

if [ -z "$VPN_REMOTEDEST" ]; then
    echo "$LOCATION: VPN_REMOTEDEST (the KNX interface's LAN address) isn't set." >&2
    echo "Find it with utils/vpn-site/test-site.sh $LOCATION, then set it here or re-run add-site.sh -f -d <address>." >&2
    exit 1
fi
if [ ! -f "$SITEDIR/$LOCATION.conf" ]; then
    echo "$LOCATION: no $SITEDIR/$LOCATION.conf" >&2
    exit 1
fi

if docker inspect "$LOCATION" >/dev/null 2>&1; then
    if [ "${1:-}" != restart ]; then
        echo "$LOCATION: a container of that name exists - '$0 restart' replaces it" >&2
        exit 1
    fi
    docker rm -f "$LOCATION" >/dev/null
fi

# -dit: the image's entrypoint ends in a foreground shell that exits (and
# stops the container) without a tty
docker run -dit --restart on-failure --privileged --name "$LOCATION" \
    --net hamon --ip "$LOC_IPADDR" \
    -v "$SITEDIR":/vpn \
    -p "$LOC_PORT:$CONT_PORT/udp" \
    -e "VPN_REMOTEDEST=$VPN_REMOTEDEST" \
    -e "VPN_REMOTEPORT=$VPN_REMOTEPORT" \
    -e "CONT_PORT=$CONT_PORT" \
    "$IMAGE" >/dev/null || exit 1

# the tunnel normally takes 5-10 s
for ((i = 0; i < 60; i++)); do
    sleep 1
    log=$(docker exec "$LOCATION" cat /var/log/openvpn.log 2>/dev/null)
    if grep -q "Initialization Sequence Completed" <<<"$log"; then
        echo "$LOCATION: tunnel up after $((i + 1)) s, $LOC_IPADDR:$LOC_PORT -> $VPN_REMOTEDEST:$VPN_REMOTEPORT"
        exit 0
    fi
    if grep -qE "AUTH_FAILED|TLS Error|Exiting due to fatal error" <<<"$log"; then
        echo "$LOCATION: the tunnel failed:" >&2
        grep -E "AUTH_FAILED|TLS Error|fatal" <<<"$log" | tail -3 >&2
        exit 1
    fi
done
echo "$LOCATION: container running, but no tunnel after 60 s - see: docker exec $LOCATION tail /var/log/openvpn.log" >&2
exit 1
