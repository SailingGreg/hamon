#!/usr/bin/env bash
# pivpn-add <name> <tunnel-ip> [site-lan-map e.g. 10.100.11.0]
# Issues a client cert + per-client tls-crypt-v2 key, writes ccd/<name> (fixed
# tunnel IP, optional iroute for the site's NETMAP'd LAN) and an inline
# clients/<name>.ovpn for the Pi.  Re-running refreshes ccd and the .ovpn only.
set -euo pipefail
NAME=$1 IP=$2 MAP=${3:-}
cd /etc/pivpn
export EASYRSA_PKI=/etc/pivpn/pki EASYRSA_BATCH=1 \
       EASYRSA_ALGO=ec EASYRSA_CURVE=prime256v1 EASYRSA_DIGEST=sha256
[ -f "pki/issued/$NAME.crt" ] || /usr/share/easy-rsa/easyrsa build-client-full "$NAME" nopass
[ -f "clients/$NAME.tc2" ] || openvpn --tls-crypt-v2 tc2-server.key --genkey tls-crypt-v2-client "clients/$NAME.tc2"
{ echo "ifconfig-push $IP 255.255.0.0"; [ -n "$MAP" ] && echo "iroute $MAP 255.255.255.0"; true; } > "ccd/$NAME"
OUT=clients/$NAME.ovpn
{
  cat <<CFG
client
dev tun
proto udp
remote $(cat public-host) 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
tls-version-min 1.2
data-ciphers CHACHA20-POLY1305:AES-256-GCM:AES-128-GCM
keepalive 10 60
verb 3
CFG
  echo "<ca>";           cat pki/ca.crt;                                                     echo "</ca>"
  echo "<cert>";         sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' "pki/issued/$NAME.crt"; echo "</cert>"
  echo "<key>";          cat "pki/private/$NAME.key";                                        echo "</key>"
  echo "<tls-crypt-v2>"; cat "clients/$NAME.tc2";                                            echo "</tls-crypt-v2>"
} > "$OUT"
chmod 0600 "$OUT"
echo "pivpn-add: $NAME -> $IP${MAP:+ (site LAN $MAP/24)}  config: $OUT"
