---
# Configuration file HAMon template
# Copy to hamon.yml and update as appropriate
title: "The HAMon configuration file"
# KNX stack for every location: knx (the default) or knxultimate. A location's
# own `stack:` overrides it. The stack also picks the library that decodes and
# encodes values; the stored values and type names are the same either way.
#stack: knxultimate
# Run every location in hamon's main thread (about 10 MB a location) instead of
# one worker thread each (about 50-60 MB). Absent or true: one thread per
# location. Takes effect on the next reload of this file, without an ha-mon
# restart, so it can be set back to true at once if needed.
#threads: false
locations:
  Location-1:
    name: "office" # the tag used for logging
    desc: "The office" # the location - not currently used
    dns: DNS-ENTRY.dyndns.org # the DNS entry
    port: 54321 # Router port
    ets: CONFIG.xml # and the ETS XML export of group addresses
  Location-2:
    name: "home"
    desc: "The home"
    dns: DNS-ENTRY.dyndns.org
    port: 12345
    ets: CONFIG.xml

# extend by adding additional locations
