[Unit]
Description=hamon hung-site freshness detector (replaces kapacitor deadmanv2)
After=network-online.target docker.service influxdb.service
Wants=network-online.target

[Service]
Type=oneshot
User=greg
Group=greg
# Live (DRYRUN=0) since 2026-10-08: replaced kapacitor deadmanv2, which is
# disabled along with the kapacitor service.  DRYRUN=1 = report only.
Environment=DRYRUN=0
WorkingDirectory=/home/greg/hamon
ExecStart=/home/greg/hamon/freshness-detector.sh
Nice=5
